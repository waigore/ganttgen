# Copy to .env and fill in. Used by ganttgen project skills / scripts.

# --- gist (update-ganttgen-gist) ---
GANTTGEN_GIST_ID=68d6eb3ded5bae7dd5ed90e49383fde8
GANTTGEN_GIST_SHORT_URL=https://is.gd/yF50Ld
# Comma-separated paths relative to the repo root
GANTTGEN_GIST_FILES=ganttgen.py,config.toml,tasks.csv

# --- generate & Tailnet serve (serve-ganttgen-html) ---
GANTTGEN_OUT=gantt.html
GANTTGEN_SERVE_PORT=8000
GANTTGEN_SERVE_BIND=0.0.0.0
GANTTGEN_PYTHON=python3
# Optional overrides:
# GANTTGEN_TASKS=tasks.csv
# GANTTGEN_CONFIG=config.toml
# Space-separated milestone filter (empty = all), e.g. M1 M3
# GANTTGEN_MILESTONES=
